<span id="S2.T2.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:125.2pt;">
<span id="S2.T2.2.1.1.1.1" class="ltx_p"><span id="S2.T2.2.1.1.1.1.1" class="ltx_text" style="font-size:80%;">Question</span></span>
</span></th>
<th id="S2.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r"><span id="S2.T2.2.1.2.1" class="ltx_text" style="font-size:80%;">MS</span></th>
