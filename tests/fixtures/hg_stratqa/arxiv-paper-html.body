<span id="S2.T1.2.1.1.1.1" class="ltx_p"><span id="S2.T1.2.1.1.1.1.1" class="ltx_text" style="font-size:80%;">Question</span></span>
</span></th>
<th id="S2.T1.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column">
