<tr id="S2.T2.2.3" class="ltx_tr">
<td id="S2.T2.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="S2.T2.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:125.2pt;">
<span id="S2.T2.2.3.1.1.1" class="ltx_p"><span id="S2.T2.2.3.1.1.1.1" class="ltx_text" style="font-size:80%;">Do cars use drinking water to power their engine? (</span><span id="S2.T2.2.3.1.1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;"> No</span><span id="S2.T2.2.3.1.1.1.3" class="ltx_text" style="font-size:80%;">)</span></span>
</span></td>
<td id="S2.T2.2.3.2" class="ltx_td ltx_border_r ltx_border_t"></td>
