allenai/strategyqa-evaluator/commit/cc6864770fe51b3b7e029185e0b1a32421280be3"}],"stats":{"total":7,"additions":6,"deletions":1},"files":[{"sha":"9717ac6bfd7f3428cb15aa87f3e0ab5873458ce1","filename":"evaluator/eval.py","status":"modified","additions":6,"deletions":1,"changes":7,"blob_url":"https://github.com/allenai/strategyqa-evaluator/blob/49b88ed2b2f1b57385c13e8a0699dee1d227f83e/evaluator%2Feval.py","raw_url":"https://github.com/allenai/strategyqa-evaluator/raw/49b88ed2b2f1b57385c13e8a0699dee1d227f83e/evaluator%2Feval.py","contents_url":"https://api.github.com/repos/allenai/strategyqa-evaluator/contents/evaluator%2Feval.py?ref=49b88ed2b2f1b57385c13e8a0699dee1d227f83e","patch":"@@ -73,6 +73,7 @@ def get_metrics(self):\n class EvaluatorWrapper:\n     def __init__(self, eval_keys, args):\n         self._evaluators = {eval_key: self._get_evaluator(eval_key, args) for eval_key in eval_keys}\n+        self._retrieval_limit = args.retrieval_limit\n \n     @staticmethod\n     def _get_evaluator(eval_key, args):\n@@ -88,7 +89,11 @@ def __getitem__(self, eval_key):\n         return self._evaluators[eval_key]\n \n     def get_metrics(self):\n-        metrics = {}\n+        metrics = {\n+            \"Accuracy\": 0.0,\n+            \"SARI\": 0.0,\n+            f\"Recall@{self._retrieval_limit}\": 0.0,\n+        }\n         for evaluator in self._evaluators.values():\n             metrics.update(evaluator.get_metrics())\n         return metrics"}]}