<td id="S4.T3.2.6.4" class="ltx_td ltx_align_center">85</td></tr>
<tr id="S4.T3.2.7" class="ltx_tr">
<td id="S4.T3.2.7.1" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><span id="S4.T3.2.7.1.1" class="ltx_text ltx_font_bold">FC+STS Objectives</span></td></tr>
<tr id="S4.T3.2.8" class="ltx_tr">
<td id="S4.T3.2.8.1" class="ltx_td ltx_align_left">Overall</td>
<td id="S4.T3.2.8.2" class="ltx_td ltx_align_center">0.635</td>
<td id="S4.T3.2.8.3" class="ltx_td ltx_align_center">4.63</td>
<td id="S4.T3.2.8.4" class="ltx_td ltx_align_center">156</td></tr>
<tr id="S4.T3.2.9" class="ltx_tr">
<td id="S4.T3.2.9.1" class="ltx_td ltx_align_left">SUPPORTS</td>
<td id="S4.T3.2.9.2" class="ltx_td ltx_align_center">0.617</td>
<td id="S4.T3.2.9.3" class="ltx_td ltx_align_center">4.77</td>
<td id="S4.T3.2.9.4" class="ltx_td ltx_align_center">67</td></tr>
<tr id="S4.T3.2.10" class="ltx_tr">
<td id="S4.T3.2.10.1" class="ltx_td ltx_align_left">REFUTES</td>
<td id="S4.T3.2.10.2" class="ltx_td ltx_align_center">0.642</td>
<td id="S4.T3.2.10.3" class="ltx_td ltx_align_center">4.68</td>
<td id="S4.T3.2.10.4" class="ltx_td ltx_align_center">28</td></tr>
<tr id="S4.T3.2.11" class="ltx_tr">
