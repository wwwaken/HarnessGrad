<td id="S4.T3.2.4.2" class="ltx_td ltx_align_center">0.486</td>
<td id="S4.T3.2.4.3" class="ltx_td ltx_align_center">4.79</td>
<td id="S4.T3.2.4.4" class="ltx_td ltx_align_center">39</td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
<td id="S4.T3.2.5.1" class="ltx_td ltx_align_left">REFUTES</td>
<td id="S4.T3.2.5.2" class="ltx_td ltx_align_center">0.494</td>
<td id="S4.T3.2.5.3" class="ltx_td ltx_align_center">4.70</td>
<td id="S4.T3.2.5.4" class="ltx_td ltx_align_center">32</td></tr>
<tr id="S4.T3.2.6" class="ltx_tr">
