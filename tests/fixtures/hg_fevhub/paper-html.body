<td id="S4.T3.2.3.2" class="ltx_td ltx_align_center">0.534</td>
<td id="S4.T3.2.3.3" class="ltx_td ltx_align_center">4.33</td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_align_center">156</td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
