<td id="A1.T4.2.35.2" class="ltx_td ltx_nopad_l ltx_align_left">there</td>
<td id="A1.T4.2.35.3" class="ltx_td ltx_nopad_l ltx_align_left">0.764</td>
<td id="A1.T4.2.35.4" class="ltx_td ltx_nopad_l ltx_align_left">4.846</td>
<td id="A1.T4.2.35.5" class="ltx_td ltx_nopad_l ltx_align_left">11.574 (42.949)</td></tr>
<tr id="A1.T4.2.36" class="ltx_tr">
<th id="A1.T4.2.36.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NEI<math id="A1.T4.m33" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>R</th>
<td id="A1.T4.2.36.2" class="ltx_td ltx_nopad_l ltx_align_left">just</td>
<td id="A1.T4.2.36.3" class="ltx_td ltx_nopad_l ltx_align_left">0.786</td>
<td id="A1.T4.2.36.4" class="ltx_td ltx_nopad_l ltx_align_left">4.916</td>
<td id="A1.T4.2.36.5" class="ltx_td ltx_nopad_l ltx_align_left">16.879 (135.73)</td></tr>
<tr id="A1.T4.2.37" class="ltx_tr">
<th id="A1.T4.2.37.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NEI<math id="A1.T4.m34" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<td id="A1.T4.2.37.2" class="ltx_td ltx_nopad_l ltx_align_left">of</td>
<td id="A1.T4.2.37.3" class="ltx_td ltx_nopad_l ltx_align_left">0.802</td>
<td id="A1.T4.2.37.4" class="ltx_td ltx_nopad_l ltx_align_left">4.917</td>
<td id="A1.T4.2.37.5" class="ltx_td ltx_nopad_l ltx_align_left">11.844 (55.871)</td></tr>
<tr id="A1.T4.2.38" class="ltx_tr">
<th id="A1.T4.2.38.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NEI<math id="A1.T4.m35" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<td id="A1.T4.2.38.2" class="ltx_td ltx_nopad_l ltx_align_left">is</td>
<td id="A1.T4.2.38.3" class="ltx_td ltx_nopad_l ltx_align_left">0.815</td>
<td id="A1.T4.2.38.4" class="ltx_td ltx_nopad_l ltx_align_left">4.931</td>
<td id="A1.T4.2.38.5" class="ltx_td ltx_nopad_l ltx_align_left">17.507 (178.55)</td></tr>
<tr id="A1.T4.2.39" class="ltx_tr">
<th id="A1.T4.2.39.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">NEI<math id="A1.T4.m36" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>S</th>
<td id="A1.T4.2.39.2" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_bb">A</td>
