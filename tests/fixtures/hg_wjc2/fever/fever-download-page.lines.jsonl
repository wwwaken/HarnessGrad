"<script>\n"
"    const offsetFromUTC = Math.floor(new Date().getTimezoneOffset() / 60);\n"
"    const offsetFromPuntaCana = offsetFromUTC+1;\n"
"    const originalHours = $('.event-time').map(function() {\n"
"        return [$(this).text().trim().split(/:|-/)];\n"
"    });\n"
"\n"
"    $('input:radio[name=timezone]').on('change', function (){\n"
"        $('.event-time').each(\n"
"            function(index){\n"
"                if ($(this).text().trim() !== '') {\n"
"                    const times = originalHours[index];\n"
"                    let offset;\n"
"                    if ($('#timezone-local').is(\":checked\"))\n"
"                        offset = offsetFromPuntaCana;\n"
"                    else\n"
"                        offset = 0;\n"
"                    let hour1 = parseInt(times[0]) - offset;\n"
"                    let hour2 = parseInt(times[2]) - offset;\n"
"                    $(this).text(hour1 + ':' + times[1] + '-' + hour2 + ':' + times[3]);\n"
"                }\n"
"            })\n"
"        }\n"
"    );\n"
"</script>\n"
"\n"
