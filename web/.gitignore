# Kept inside web/ so the SPA owns its own build artefacts without touching the platform's
# ignore rules (which are outside this worker's scope).
node_modules/
# `dist/` is deliberately NOT ignored: the built bundle is committed so that a demo
# needs no npm and no network, which was the one honest argument the old
# hand-written page had over a build step. `node_modules/` still is.
.vite/
coverage/
*.tsbuildinfo
