@@ -73,6 +73,22 @@
             if f.exists():
                 stem, suffix = name.split(".", 1)
                 shutil.move(str(f), str(target / f"{stem}.{run_id}.{suffix}"))
+        # Preserve the per-task verdicts, namespaced by their original run id.
+        # Before this, only progress/ and the three metadata files were folded and the
+        # source was then deleted outright, so every verdict byte was destroyed -- the
+        # four existing archives contain zero verdict files for exactly that reason.
+        # This helps FUTURE folds only; it cannot recreate what was already deleted.
+        src_verdicts = src / "verdicts"
+        if src_verdicts.is_dir():
+            dst_verdicts = target / "verdicts" / run_id
+            for f in sorted(src_verdicts.rglob("*")):
+                if not f.is_file():
+                    continue
+                dst = dst_verdicts / f.relative_to(src_verdicts)
+                dst.parent.mkdir(parents=True, exist_ok=True)
+                if dst.exists():
+                    raise SystemExit(f"verdict collision at {dst} -- refusing to overwrite")
+                shutil.move(str(f), str(dst))
         shutil.rmtree(src, ignore_errors=True)
 
     return stats
