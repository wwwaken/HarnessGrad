#!/usr/bin/env python3
r"""`jer` -- the command line the agent uses to play a Jericho interactive-fiction game.

    python3 jer look                show the current observation
    python3 jer do "<command>"      apply one game command
    python3 jer score               the game's score, the maximum, and the moves spent
    python3 jer inventory           what the agent is carrying
    python3 jer valid               the actions Jericho believes are available
    python3 jer done                declare the episode over and stop acting
    python3 jer help                this text

Why a CLI, and why the log is replayed
--------------------------------------
The platform grades what a harness left behind, and an interactive-fiction episode is a
transcript rather than an artifact. So every command goes through here and is appended to
`jer_actions.jsonl`; the check then rebuilds the game at its official seed and replays the log,
reading the game's own score. Nothing this program prints is a verdict.

A fresh process per command means the game is rebuilt and the log replayed every time -- the
same O(n^2) design as `alf` and `scw`, and for the same reason: one code path builds the world
the agent saw and the world being scored. Jericho's interpreter is fast (Zork 1's 396-move
walkthrough replays in well under a second), so the cost is a process launch per command.

Where things live (override with the matching flag):
    <workdir>/jer_game.json       the game and its seed, written by the platform's SETUP
    <workdir>/<rom>               the game file, written by SETUP and by VERIFY
    <workdir>/jer_actions.jsonl   this program's append-only output
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import jer_env  # noqa: E402


def _fail(message: str, code: int = 2) -> int:
    print(f"error: {message}", file=sys.stderr)
    return code


def _current(args):
    """Build the game and replay the log. Returns `(env, last_step_or_None, actions)`."""
    records = jer_env.action_log_records(args.log)
    actions = jer_env.actions_in(records)
    env = jer_env.load_game(args.workdir, rom_dir=args.rom_dir)
    steps = jer_env.replay(env, actions)
    return env, (steps[-1] if steps else None), actions


def cmd_look(args) -> int:
    env, last, actions = _current(args)
    if last is None:
        # No actions yet: the game's opening text is the observation. `reset` already ran,
        # and `get_state`-free re-reading is not available, so ask the game to look.
        observation, _reward, _done, info = env.step("look")
    else:
        observation, info = last["observation"], last
    print(str(observation).strip())
    print()
    print(f"[jer] move {actions and (last or {}).get('moves', 0) or info.get('moves', 0)}; "
          f"score {info.get('score', 0)}/{env.get_max_score()}")
    return 0


def cmd_do(args) -> int:
    action = " ".join(args.action).strip()
    if not action:
        return _fail('usage: jer do "<command>"')
    env, last, actions = _current(args)
    observation, _reward, done, info = env.step(action)
    jer_env.append_action(args.log, action, len(actions))
    print(str(observation).strip())
    print()
    print(f"[jer] move {info.get('moves', 0)}; score {info.get('score', 0)}/"
          f"{env.get_max_score()}" + ("; the game is over" if done else ""))
    return 0


def cmd_score(args) -> int:
    env, last, actions = _current(args)
    score = (last or {}).get("score", 0)
    moves = (last or {}).get("moves", 0)
    maximum = env.get_max_score()
    print(f"score {score}/{maximum}; moves {moves}; actions logged {len(actions)}")
    return 0


def cmd_inventory(args) -> int:
    env, _last, _actions = _current(args)
    print(str(env.get_inventory()).strip())
    return 0


def cmd_valid(args) -> int:
    """Best-guess admissible actions. Not an action: it does not consume the budget."""
    env, _last, _actions = _current(args)
    for action in env.get_valid_actions():
        print(action)
    return 0


def cmd_done(args) -> int:
    records = jer_env.action_log_records(args.log)
    if not any(r.get("kind") == "done" for r in records):
        jer_env.append_marker(args.log, "done", len(jer_env.actions_in(records)))
    print("Noted. The episode is marked done.")
    return 0


def _parse_global(argv: list) -> tuple[argparse.Namespace, list]:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--workdir", default=".")
    parser.add_argument("--log", default=None)
    parser.add_argument("--rom-dir", default=None,
                        help="where the ROM is; defaults to --workdir")
    known, rest = parser.parse_known_args(argv)
    known.workdir = Path(known.workdir)
    known.rom_dir = Path(known.rom_dir) if known.rom_dir else known.workdir
    known.log = Path(known.log) if known.log else known.workdir / jer_env.LOG_FILENAME
    return known, rest


USAGE = """jer -- play a Jericho interactive-fiction game

  python3 jer look            show the current observation
  python3 jer do "<command>"  apply one game command
  python3 jer score           the game's score, the maximum, and the moves spent
  python3 jer inventory       what you are carrying
  python3 jer valid           the actions Jericho believes are available
  python3 jer done            declare the episode over

Options (anywhere on the line): --workdir DIR --log FILE --rom-dir DIR
The game is {game}; the action log is {log}.
""".format(game=jer_env.GAME_FILENAME, log=jer_env.LOG_FILENAME)


def main(argv: list) -> int:
    args, rest = _parse_global(list(argv))
    if not rest or rest[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    command, rest = rest[0], rest[1:]
    if command == "look":
        return cmd_look(args)
    if command == "do":
        args.action = rest
        return cmd_do(args)
    if command == "score":
        return cmd_score(args)
    if command == "inventory":
        return cmd_inventory(args)
    if command == "valid":
        return cmd_valid(args)
    if command == "done":
        return cmd_done(args)
    print(f"error: unknown command {command!r}", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
