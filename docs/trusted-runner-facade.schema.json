{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessgrad.local/schemas/study-evaluation-service-v1.json",
  "title": "Study evaluation and deployment service (design draft)",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/build_validate_request"
    },
    {
      "$ref": "#/$defs/evaluate_candidates_request"
    },
    {
      "$ref": "#/$defs/select_deploy_request"
    },
    {
      "$ref": "#/$defs/build_validate_response"
    },
    {
      "$ref": "#/$defs/evaluate_candidates_response"
    },
    {
      "$ref": "#/$defs/select_deploy_response"
    },
    {
      "$ref": "#/$defs/final_report_response"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "id"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "framework",
            "method",
            "evaluator",
            "deployer",
            "recorder",
            "delegate"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "parent_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "root", "snapshot_sha"],
          "properties": {
            "role": {"const": "root"},
            "root": {"const": true},
            "snapshot_sha": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "role", "snapshot_sha"],
          "properties": {
            "artifact_id": {"$ref": "#/$defs/id"},
            "role": {
              "type": "string",
              "enum": ["base", "donor", "peer", "crossover", "evidence"]
            },
            "snapshot_sha": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "content_sha",
        "producer",
        "visibility"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "parent_state",
            "candidate",
            "tree_snapshot",
            "patch",
            "validation",
            "study_score",
            "final_exam_score",
            "selection",
            "deployment",
            "trace",
            "task_set",
            "final_report"
          ]
        },
        "content_sha": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "producer": {
          "$ref": "#/$defs/owner"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "framework",
            "study_public",
            "final_exam_private",
            "deployment_record",
            "final_report_private"
          ]
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parent_ref"
          },
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "task_set_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_set_id",
        "task_set_sha",
        "visibility",
        "scorer_revision",
        "task_ids"
      ],
      "properties": {
        "task_set_id": {
          "$ref": "#/$defs/id"
        },
        "task_set_sha": {
          "$ref": "#/$defs/sha256"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "study",
            "validation",
            "final_exam"
          ]
        },
        "scorer_revision": {
          "$ref": "#/$defs/nonempty"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "manifest_sha": {
          "$ref": "#/$defs/sha256"
        },
        "adaptation_visible": {
          "type": "boolean"
        },
        "capability_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "study_task_set_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/task_set_ref"
        },
        {
          "type": "object",
          "required": ["visibility", "adaptation_visible", "capability_id"],
          "properties": {
            "visibility": {
              "type": "string",
              "enum": [
                "study",
                "validation"
              ]
            },
            "adaptation_visible": {
              "const": true
            }
          }
        }
      ]
    },
    "candidate_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "artifact", "lineage"],
      "allOf": [
        {
          "anyOf": [
            {"required": ["base_snapshot_sha"]},
            {"required": ["root"]}
          ]
        },
        {
          "if": {"required": ["root"]},
          "then": {"properties": {"root": {"const": true}}, "not": {"required": ["base_snapshot_sha"]}}
        },
        {
          "if": {"required": ["base_snapshot_sha"]},
          "then": {"properties": {"root": {"const": false}}}
        }
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "artifact": {"$ref": "#/$defs/artifact_ref"},
        "lineage": {
          "type": "array",
          "items": {"$ref": "#/$defs/parent_ref"},
          "minItems": 1,
          "uniqueItems": true
        },
        "base_snapshot_sha": {"$ref": "#/$defs/sha256"},
        "root": {"type": "boolean"},
        "proposal_kind": {
          "type": "string",
          "enum": [
            "patch", "full_file", "tree", "config", "prompt", "skill", "memory", "policy",
            "checkpoint", "parameter_update"
          ]
        },
        "expected_content_sha": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "artifact_id",
        "candidate_snapshot_sha",
        "immutable"
      ],
      "allOf": [
        {"anyOf": [{"required": ["base_snapshot_sha"]}, {"required": ["root"]}]},
        {"if": {"required": ["root"]}, "then": {"properties": {"root": {"const": true}}, "not": {"required": ["base_snapshot_sha"]}}},
        {"if": {"required": ["base_snapshot_sha"]}, "then": {"properties": {"root": {"const": false}}}}
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "base_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "root": {"type": "boolean"},
        "candidate_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "immutable": {
          "const": true
        },
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parent_ref"
          },
          "minItems": 1
        }
      }
    },
    "validation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "detail": {
          "type": "string"
        },
        "evidence_sha": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "status",
        "checks",
        "candidate_snapshot_sha"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "unobserved"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_check"
          }
        },
        "candidate_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "validation_artifact": {
          "$ref": "#/$defs/artifact_ref"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "attribution"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "invalid_input",
            "invalid_patch",
            "subject_timeout",
            "subject_error",
            "budget_exhausted",
            "evaluator_error",
            "recorder_error",
            "infrastructure_unavailable",
            "cancelled"
          ]
        },
        "attribution": {
          "type": "string",
          "enum": [
            "subject",
            "infrastructure"
          ]
        },
        "stage": {
          "$ref": "#/$defs/nonempty"
        },
        "detail": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "trial_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "status",
        "score_kind",
        "cost"
      ],
      "properties": {
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "subject_failed",
            "infrastructure_failed",
            "cancelled"
          ]
        },
        "score": {
          "type": "number"
        },
        "score_kind": {
          "type": "string",
          "enum": [
            "study",
            "validation"
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "trace_sha": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting_revision"
      ],
      "properties": {
        "accounting_revision": {
          "$ref": "#/$defs/nonempty"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_ms": {
          "type": "integer",
          "minimum": 0
        },
        "usd_micros": {
          "type": "integer",
          "minimum": 0
        },
        "known": {
          "type": "boolean"
        }
      }
    },
    "task_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "trials",
        "aggregate"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trial_outcome"
          },
          "minItems": 1
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n_requested",
            "n_terminal",
            "n_measured"
          ],
          "properties": {
            "n_requested": {
              "type": "integer",
              "minimum": 1
            },
            "n_terminal": {
              "type": "integer",
              "minimum": 0
            },
            "n_measured": {
              "type": "integer",
              "minimum": 0
            },
            "mean_score": {
              "type": "number"
            },
            "stddev": {
              "type": "number",
              "minimum": 0
            },
            "cost": {
              "$ref": "#/$defs/cost"
            }
          }
        }
      }
    },
    "evaluation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "candidate_id",
        "task_set",
        "k",
        "completeness",
        "measurement_status",
        "task_outcomes",
        "result_sha"
      ],
      "properties": {
        "evaluation_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "task_set": {
          "$ref": "#/$defs/study_task_set_ref"
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "type": "string",
          "enum": [
            "partial",
            "staged",
            "full"
          ]
        },
        "measurement_status": {
          "type": "string",
          "enum": [
            "eligible",
            "incomplete",
            "unobserved"
          ]
        },
        "stage_id": {
          "$ref": "#/$defs/id"
        },
        "requested_cells": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_cells": {
          "type": "integer",
          "minimum": 0
        },
        "measured_cells": {
          "type": "integer",
          "minimum": 0
        },
        "infrastructure_failed_cells": {
          "type": "integer",
          "minimum": 0
        },
        "task_outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task_outcome"
          }
        },
        "aggregate_score": {
          "type": "number"
        },
        "aggregate_cost": {
          "$ref": "#/$defs/cost"
        },
        "score_artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "result_sha": {
          "$ref": "#/$defs/sha256"
        },
        "method_utility": {
          "$ref": "#/$defs/method_utility"
        }
      }
    },
    "selection_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id",
        "incumbent_id",
        "selected_candidate_ids",
        "retained_incumbent",
        "basis_artifact_ids",
        "basis_artifacts",
        "eligible"
      ],
      "properties": {
        "selection_id": {
          "$ref": "#/$defs/id"
        },
        "incumbent_id": {
          "$ref": "#/$defs/id"
        },
        "selected_candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "retained_incumbent": {
          "type": "boolean"
        },
        "basis_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "eligible": {
          "type": "boolean"
        },
        "tentative": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "decision_sha": {
          "$ref": "#/$defs/sha256"
        },
        "basis_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adaptation_basis_artifact"
          },
          "minItems": 1
        }
      }
    },
    "deployment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "selection_id",
        "status",
        "deployed_candidate_ids",
        "from_snapshot_sha",
        "to_snapshot_sha"
      ],
      "properties": {
        "deployment_id": {
          "$ref": "#/$defs/id"
        },
        "selection_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "none",
            "deployed",
            "tentative",
            "rolled_back",
            "failed"
          ]
        },
        "deployed_candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "from_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "to_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "rollback_of": {
          "$ref": "#/$defs/id"
        },
        "deployment_artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "build_validate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "run_id",
        "iteration_id",
        "parents",
        "parent_set_sha",
        "proposals",
        "idempotency_key"
      ],
      "properties": {
        "operation": {
          "const": "build_validate"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "iteration_id": {
          "$ref": "#/$defs/id"
        },
        "parents": {
          "type": "array",
          "items": {"$ref": "#/$defs/parent_ref"},
          "minItems": 1,
          "uniqueItems": true
        },
        "parent_set_sha": {
          "$ref": "#/$defs/sha256"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_input"
          },
          "minItems": 1
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        },
        "smoke_policy": {
          "type": "object"
        }
      }
    },
    "evaluate_candidates_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "run_id",
        "iteration_id",
        "candidate_ids",
        "k",
        "completeness",
        "evaluation_scope",
        "idempotency_key"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation_scope": {
                "enum": [
                  "study",
                  "validation"
                ]
              }
            }
          },
          "then": {
            "required": [
              "task_set"
            ],
            "not": {
              "required": [
                "final_report_capability_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluation_scope": {
                "const": "final_report_only"
              }
            }
          },
          "then": {
            "required": [
              "selection_id",
              "final_report_capability_id",
              "finalization_seal"
            ],
            "not": {
              "required": [
                "task_set"
              ]
            }
          }
        }
      ],
      "properties": {
        "operation": {
          "const": "evaluate_candidates"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "iteration_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "task_set": {
          "$ref": "#/$defs/study_task_set_ref"
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "type": "string",
          "enum": [
            "partial",
            "staged",
            "full"
          ]
        },
        "stage_id": {
          "$ref": "#/$defs/id"
        },
        "selection_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_scope": {
          "type": "string",
          "enum": [
            "study",
            "validation",
            "final_report_only"
          ]
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        },
        "final_report_capability_id": {
          "$ref": "#/$defs/id",
          "description": "Private capability; never visible to method or adaptation."
        },
        "finalization_seal": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "select_deploy_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "action",
        "run_id",
        "iteration_id",
        "idempotency_key"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "incumbent_id",
              "candidate_ids",
              "evaluation_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "deploy"
              }
            }
          },
          "then": {
            "required": [
              "selection_id",
              "expected_from_snapshot_sha"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "rollback"
              }
            }
          },
          "then": {
            "required": [
              "selection_id",
              "deployment_id",
              "rollback_of"
            ]
          }
        }
      ],
      "properties": {
        "operation": {
          "const": "select_deploy"
        },
        "action": {
          "type": "string",
          "enum": [
            "select",
            "deploy",
            "rollback"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "iteration_id": {
          "$ref": "#/$defs/id"
        },
        "incumbent_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "evaluation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "selection_id": {
          "$ref": "#/$defs/id"
        },
        "deployment_id": {
          "$ref": "#/$defs/id"
        },
        "expected_from_snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "rollback_of": {
          "$ref": "#/$defs/id"
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "build_validate_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "parent_set_sha",
        "parents",
        "candidates",
        "valid_candidate_ids"
      ],
      "properties": {
        "operation": {
          "const": "build_validate"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "parent_set_sha": {
          "$ref": "#/$defs/sha256"
        },
        "parents": {
          "type": "array",
          "items": {"$ref": "#/$defs/parent_ref"},
          "minItems": 1,
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_ref"
          }
        },
        "valid_candidate_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_result"
          }
        }
      }
    },
    "evaluate_candidates_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "evaluation_scope",
        "results"
      ],
      "properties": {
        "operation": {
          "const": "evaluate_candidates"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_scope": {
          "type": "string",
          "enum": [
            "study",
            "validation"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluation_result"
          }
        }
      }
    },
    "select_deploy_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "action"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "selection"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "deploy",
                  "rollback"
                ]
              }
            }
          },
          "then": {
            "required": [
              "deployment"
            ]
          }
        }
      ],
      "properties": {
        "operation": {
          "const": "select_deploy"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "type": "string",
          "enum": [
            "select",
            "deploy",
            "rollback"
          ]
        },
        "selection": {
          "$ref": "#/$defs/selection_decision"
        },
        "deployment": {
          "$ref": "#/$defs/deployment_result"
        }
      }
    },
    "method_utility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utility_revision",
        "input_artifact_ids",
        "value"
      ],
      "properties": {
        "utility_revision": {
          "$ref": "#/$defs/nonempty"
        },
        "input_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "value": {
          "type": "number"
        },
        "raw_score": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "gate": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "final_task_set_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/task_set_ref"
        },
        {
          "type": "object",
          "properties": {
            "visibility": {
              "const": "final_exam"
            },
            "adaptation_visible": {
              "const": false
            }
          },
          "required": [
            "visibility",
            "adaptation_visible",
            "capability_id"
          ]
        }
      ]
    },
    "final_trial_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "status",
        "score_kind",
        "cost"
      ],
      "properties": {
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "subject_failed",
            "infrastructure_failed",
            "cancelled"
          ]
        },
        "score": {
          "type": "number"
        },
        "score_kind": {
          "const": "final_exam"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "trace_sha": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_sha": {
          "$ref": "#/$defs/sha256"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "final_task_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "trials",
        "aggregate"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/final_trial_outcome"
          },
          "minItems": 1
        },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n_requested",
            "n_terminal",
            "n_measured"
          ],
          "properties": {
            "n_requested": {
              "type": "integer",
              "minimum": 1
            },
            "n_terminal": {
              "type": "integer",
              "minimum": 0
            },
            "n_measured": {
              "type": "integer",
              "minimum": 0
            },
            "mean_score": {
              "type": "number"
            },
            "stddev": {
              "type": "number",
              "minimum": 0
            },
            "cost": {
              "$ref": "#/$defs/cost"
            }
          }
        }
      }
    },
    "final_report_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "candidate_id",
        "task_set",
        "k",
        "completeness",
        "measurement_status",
        "task_outcomes",
        "report_artifact",
        "result_sha"
      ],
      "properties": {
        "evaluation_id": {
          "$ref": "#/$defs/id"
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "task_set": {
          "$ref": "#/$defs/final_task_set_ref"
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "const": "full"
        },
        "measurement_status": {
          "type": "string",
          "enum": [
            "reported",
            "incomplete",
            "unobserved"
          ]
        },
        "requested_cells": {
          "type": "integer",
          "minimum": 1
        },
        "terminal_cells": {
          "type": "integer",
          "minimum": 0
        },
        "measured_cells": {
          "type": "integer",
          "minimum": 0
        },
        "infrastructure_failed_cells": {
          "type": "integer",
          "minimum": 0
        },
        "task_outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/final_task_outcome"
          }
        },
        "aggregate_score": {
          "type": "number"
        },
        "aggregate_cost": {
          "$ref": "#/$defs/cost"
        },
        "report_artifact": {
          "$ref": "#/$defs/artifact_ref",
          "allOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "final_report"
                },
                "visibility": {
                  "const": "final_report_private"
                }
              }
            }
          ]
        },
        "result_sha": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "final_report_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "operation_id",
        "evaluation_scope",
        "final_report_results",
        "final_report_private"
      ],
      "properties": {
        "operation": {
          "const": "evaluate_candidates"
        },
        "operation_id": {
          "$ref": "#/$defs/id"
        },
        "evaluation_scope": {
          "const": "final_report_only"
        },
        "final_report_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/final_report_result"
          }
        },
        "final_report_private": {
          "const": true
        }
      }
    },
    "adaptation_basis_artifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "visibility"
          ],
          "properties": {
            "kind": {
              "enum": [
                "validation",
                "study_score",
                "task_set",
                "trace"
              ]
            },
            "visibility": {
              "enum": [
                "framework",
                "study_public"
              ]
            }
          }
        }
      ]
    }
  }
}
