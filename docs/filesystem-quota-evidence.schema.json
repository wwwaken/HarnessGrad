        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namespace_absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "remaining_ids", "query_complete", "evidence_sha256"],
      "properties": {
        "kind": {
          "enum": [
            "container",
            "network",
            "snapshot",
            "volume",
            "workspace",
            "project_scope",
            "tmpfs_scope",
            "reservation"
          ]
        },
        "remaining_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 0, "maxItems": 64, "uniqueItems": true},
        "query_complete": {"type": "boolean"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope_cleanup": {
      "type": "object",
