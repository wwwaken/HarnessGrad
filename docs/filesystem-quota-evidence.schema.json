        "writable_inodes": {"$ref": "#/$defs/nonnegative"},
        "free_bytes": {"$ref": "#/$defs/nonnegative"},
        "free_inodes": {"$ref": "#/$defs/nonnegative"},
        "reserved_bytes": {"$ref": "#/$defs/nonnegative"},
        "reserved_inodes": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "snapshot_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "oom_killed",
        "timed_out",
        "started_at",
        "finished_at",
        "image_id",
        "artifact_sha256",
        "allocated_bytes",
        "inodes"
      ],
      "properties": {
        "state": {"enum": ["not_started", "succeeded", "failed", "timed_out", "unknown"]},
        "exit_code": {"anyOf": [{"$ref": "#/$defs/exit_code"}, {"type": "null"}]},
        "oom_killed": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "timed_out": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "started_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "finished_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "image_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "artifact_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "allocated_bytes": {"anyOf": [{"$ref": "#/$defs/nonnegative"}, {"type": "null"}]},
        "inodes": {"anyOf": [{"$ref": "#/$defs/nonnegative"}, {"type": "null"}]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "container_id",
        "docker_storage_record_sha256",
        "quiescence",
        "limits",
        "capacity",
        "worker_resource_receipt_sha256",
        "destination_scope_id",
        "destination_enforcement_record_sha256",
        "operation",
        "ownership_inventory_sha256"
      ],
      "properties": {
