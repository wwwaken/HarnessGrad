        "limits": {"$ref": "#/$defs/snapshot_limits"},
        "capacity": {"$ref": "#/$defs/capacity"},
        "worker_resource_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "destination_scope_id": {"$ref": "#/$defs/id"},
        "destination_enforcement_record_sha256": {"$ref": "#/$defs/sha256"},
        "operation": {"$ref": "#/$defs/snapshot_operation"},
        "ownership_inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owned_object": {
